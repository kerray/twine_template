:: Script [script]
// Game variables initialization
$(document).on(':storyready', function() {
    if (!State.variables.gameStarted) {
        State.variables.gameStarted = false;
        State.variables.visitedStart = true;
    }
    
    // Apply life phase class based on character's life stage
    if (State.variables.character && State.variables.character.lifeStage) {
        gameUtils.updateLifePhaseClass();
    }
});

// Update life phase class on passage render
$(document).on(':passagerender', function() {
    if (State.variables.character && State.variables.character.lifeStage) {
        gameUtils.updateLifePhaseClass();
    }
});

// Game functions
window.gameUtils = {
    // Apply life phase class to body based on character's life stage
    updateLifePhaseClass: function() {
        // Remove all life phase classes first
        document.body.classList.remove('childhood', 'teenage', 'youngadult', 'parent', 'elder');
        
        // Add the appropriate class based on current life stage
        if (State.variables.character && State.variables.character.lifeStage) {
            document.body.classList.add(State.variables.character.lifeStage);
        }
    },
    
    resetGameState: function() {
        // Reset all game variables to their initial state
        // Clear existing variables
        Object.keys(State.variables).forEach(function(key) {
            delete State.variables[key];
        });
        
        // Set initial values
        State.variables.gameStarted = true;
        State.variables.visitedStart = true;
        
        // Initialize character
        State.variables.character = {
            name: "",
            gender: "",
            age: 3,
            lifeStage: "childhood",
            traits: [],
            experiences: []
        };
        
        // Initialize attributes
        State.variables.attributes = {
            strength: 3,     // Physical power
            dexterity: 3,    // Agility and coordination
            perception: 3,   // Awareness of surroundings
            intelligence: 3, // Problem-solving and learning
            charisma: 3      // Social influence
        };
        
        // Initialize skills
        State.variables.skills = {
            // Survival
            hunting: 0,
            tracking: 0,
            fishing: 0,
            fireMaking: 0,
            
            // Gathering
            plantIdentification: 0,
            foraging: 0,
            waterFinding: 0,
            
            // Crafting
            toolMaking: 0,
            hideWorking: 0,
            weaving: 0,
            
            // Social
            storytelling: 0,
            leadership: 0,
            trading: 0,
            
            // Physical
            running: 1,
            climbing: 0,
            swimming: 0,
            strength: 1,
            
            // Knowledge
            medicinalPlants: 0,
            weatherPrediction: 0,
            navigation: 0
        };
        
        // Initialize needs
        State.variables.needs = {
            hunger: 70,      // 0-100 (0: starving, 100: full)
            thirst: 70,      // 0-100 (0: dehydrated, 100: quenched)
            fatigue: 30,     // 0-100 (0: well-rested, 100: exhausted)
            health: 100      // 0-100 (0: dying, 100: perfect health)
        };
        
        // Initialize relationships
        State.variables.relationships = {
            "mother": 80,
            "father": 80,
            "sibling": 70,
            "grandmother": 75,
            "grandfather": 75,
            "tribalLeader": 50,
            "shaman": 50,
            "bestFriend": 70,
            "rival": 30
        };
        
        // Initialize inventory
        State.variables.inventory = {
            // Personal items carried
            carrying: [],
            // Family storage
            familyStorage: {
                food: [],
                materials: [],
                tools: [],
                medicine: [],
                personal: []
            }
        };
        
        // Initialize environment
        State.variables.environment = {
            season: "summer",
            weather: "clear",
            timeOfDay: "morning",
            currentLocation: "homecamp"
        };
        
        // Initialize game progress
        State.variables.gameProgress = {
            discoveredLocations: ["homecamp"],
            completedEvents: [],
            currentQuests: [],
            ageProgressionPoints: [],
            tribeStatus: "neutral" // How the tribe views the player
        };
        
        // Apply the childhood life phase class
        this.updateLifePhaseClass();
        
        // Save the clean state
        Save.autosave.save();
    },
    
    // Need Management Functions
    updateNeeds: function(activity, duration) {
        // Different activities affect needs differently
        let hungerChange = 5 * duration; // Base rate
        let thirstChange = 7 * duration; // Base rate
        let fatigueChange = 3 * duration; // Base rate
        
        // Modify based on activity
        switch(activity) {
            case "running":
                hungerChange *= 1.5;
                thirstChange *= 2;
                fatigueChange *= 2;
                break;
            case "swimming":
                hungerChange *= 1.7;
                thirstChange *= 1.5;
                fatigueChange *= 2.2;
                break;
            case "resting":
                hungerChange *= 0.5;
                thirstChange *= 0.7;
                fatigueChange = -10 * duration; // Recover fatigue
                break;
            // Additional activities
        }
        
        // Apply changes
        State.variables.needs.hunger = Math.max(0, State.variables.needs.hunger - hungerChange);
        State.variables.needs.thirst = Math.max(0, State.variables.needs.thirst - thirstChange);
        State.variables.needs.fatigue = Math.min(100, Math.max(0, State.variables.needs.fatigue + fatigueChange));
        
        // Check for critical needs
        this.checkCriticalNeeds();
    },
    
    checkCriticalNeeds: function() {
        if (State.variables.needs.hunger <= 0) {
            State.variables.needs.health -= 5;
            return "hunger";
        }
        if (State.variables.needs.thirst <= 0) {
            State.variables.needs.health -= 10;
            return "thirst";
        }
        if (State.variables.needs.fatigue >= 100) {
            State.variables.needs.health -= 3;
            return "fatigue";
        }
        if (State.variables.needs.health <= 0) {
            // Handle death or extreme illness
            return "health";
        }
        return null;
    },
    
    // Skill System Functions
    skillCheck: function(skill, difficulty) {
        // Base chance from skill level (0-100%)
        let skillLevel = State.variables.skills[skill] || 0;
        let chance = skillLevel * 10;
        
        // Modify by relevant attribute
        let relevantAttribute = this.getRelevantAttribute(skill);
        let attributeValue = State.variables.attributes[relevantAttribute];
        chance += attributeValue * 5;
        
        // Adjust for difficulty (0: very easy, 10: nearly impossible)
        chance -= difficulty * 10;
        
        // Adjust for needs
        if (State.variables.needs.hunger < 30) chance -= 10;
        if (State.variables.needs.thirst < 20) chance -= 15;
        if (State.variables.needs.fatigue > 70) chance -= 20;
        if (State.variables.needs.health < 50) chance -= 15;
        
        // Bound between 5% and 95% (always a small chance of success/failure)
        chance = Math.min(95, Math.max(5, chance));
        
        // Determine result
        let roll = Math.random() * 100;
        let success = roll < chance;
        
        // Critical success/failure
        let critical = false;
        if (roll < 5) {
            success = true;
            critical = true;
        } else if (roll > 95) {
            success = false;
            critical = true;
        }
        
        // Improve skill slightly on attempt, more on success
        this.improveSkill(skill, success ? 0.2 : 0.1);
        
        return {
            skill: skill,
            difficulty: difficulty,
            chance: chance,
            roll: roll,
            success: success,
            critical: critical
        };
    },
    
    getRelevantAttribute: function(skill) {
        // Map skills to their most relevant attributes
        const skillAttributeMap = {
            // Survival skills
            hunting: "perception",
            tracking: "perception",
            fishing: "dexterity",
            fireMaking: "dexterity",
            
            // Gathering skills
            plantIdentification: "intelligence",
            foraging: "perception",
            waterFinding: "perception",
            
            // Crafting skills
            toolMaking: "dexterity",
            hideWorking: "dexterity",
            weaving: "dexterity",
            
            // Social skills
            storytelling: "charisma",
            leadership: "charisma",
            trading: "charisma",
            
            // Physical skills
            running: "strength",
            climbing: "strength",
            swimming: "strength",
            strength: "strength",
            
            // Knowledge skills
            medicinalPlants: "intelligence",
            weatherPrediction: "intelligence",
            navigation: "intelligence"
        };
        
        return skillAttributeMap[skill] || "perception"; // Default to perception
    },
    
    getSkillCategory: function(skill) {
        // Map skills to their categories
        const skillCategoryMap = {
            // Survival skills
            hunting: "survival",
            tracking: "survival",
            fishing: "survival",
            fireMaking: "survival",
            
            // Gathering skills
            plantIdentification: "gathering",
            foraging: "gathering",
            waterFinding: "gathering",
            
            // Crafting skills
            toolMaking: "crafting",
            hideWorking: "crafting",
            weaving: "crafting",
            
            // Social skills
            storytelling: "social",
            leadership: "social",
            trading: "social",
            
            // Physical skills
            running: "physical",
            climbing: "physical",
            swimming: "physical",
            strength: "physical",
            
            // Knowledge skills
            medicinalPlants: "knowledge",
            weatherPrediction: "knowledge",
            navigation: "knowledge"
        };
        
        return skillCategoryMap[skill] || "general"; // Default to general
    },
    
    improveSkill: function(skill, amount) {
        if (!State.variables.skills[skill]) return;
        
        // Apply learning rate modifiers
        if (State.variables.character.lifeStage === "childhood") {
            amount *= 1.5; // Children learn faster
        }
        
        // Apply specialization bonuses
        if (State.variables.character.specialization === this.getSkillCategory(skill)) {
            amount *= 1.3; // Bonus for focusing on specialization
        }
        
        // Apply diminishing returns for higher skill levels
        let currentLevel = State.variables.skills[skill];
        let diminishingFactor = 1 - (currentLevel / 15); // Slower improvement at higher levels
        amount *= Math.max(0.3, diminishingFactor);
        
        // Apply the improvement
        State.variables.skills[skill] += amount;
        
        // Cap based on life stage
        let cap = 10;
        if (State.variables.character.lifeStage === "childhood") cap = 5;
        else if (State.variables.character.lifeStage === "teenage") cap = 7;
        
        State.variables.skills[skill] = Math.min(cap, State.variables.skills[skill]);
    },
    
    hasSkillLevelIncreased: function(skill) {
        // Check if the skill has increased to a new integer level
        if (!State.temporary.previousSkillLevels) {
            State.temporary.previousSkillLevels = {};
        }
        
        const prevLevel = Math.floor(State.temporary.previousSkillLevels[skill] || 0);
        const currentLevel = Math.floor(State.variables.skills[skill] || 0);
        
        // Update the previous level
        State.temporary.previousSkillLevels[skill] = State.variables.skills[skill];
        
        return currentLevel > prevLevel;
    },
    
    // Relationship System Functions
    changeRelationship: function(npc, amount, type) {
        if (!State.variables.relationships[npc]) return;
        
        // Apply relationship change
        State.variables.relationships[npc] += amount;
        
        // Keep within bounds
        State.variables.relationships[npc] = Math.min(100, Math.max(0, State.variables.relationships[npc]));
        
        // Record significant changes
        if (Math.abs(amount) >= 5) {
            if (!State.variables.relationshipHistory) {
                State.variables.relationshipHistory = {};
            }
            if (!State.variables.relationshipHistory[npc]) {
                State.variables.relationshipHistory[npc] = [];
            }
            
            State.variables.relationshipHistory[npc].push({
                age: State.variables.character.age,
                change: amount,
                type: type || "general",
                value: State.variables.relationships[npc]
            });
        }
        
        return State.variables.relationships[npc];
    },
    
    getRelationshipTier: function(npc) {
        let value = State.variables.relationships[npc];
        
        if (value >= 90) return "devoted";
        if (value >= 75) return "close";
        if (value >= 60) return "friendly";
        if (value >= 45) return "neutral";
        if (value >= 30) return "distant";
        if (value >= 15) return "cold";
        return "hostile";
    },
    
    // Time and Aging System Functions
    ageCharacter: function(years, months) {
        years = years || 0;
        months = months || 0;
        
        // Convert to total months for precision
        let totalMonths = (years * 12) + months;
        
        // Current age in months
        let currentAgeMonths = Math.floor(State.variables.character.age * 12);
        
        // New age in months
        let newAgeMonths = currentAgeMonths + totalMonths;
        
        // Convert back to years with decimal
        State.variables.character.age = newAgeMonths / 12;
        
        // Check for life stage transitions
        this.checkLifeStageTransition();
        
        // Record aging point
        if (!State.variables.gameProgress.ageProgressionPoints) {
            State.variables.gameProgress.ageProgressionPoints = [];
        }
        
        State.variables.gameProgress.ageProgressionPoints.push({
            newAge: State.variables.character.age,
            passage: State.passage
        });
        
        return State.variables.character.age;
    },
    
    checkLifeStageTransition: function() {
        let age = State.variables.character.age;
        let currentStage = State.variables.character.lifeStage;
        let newStage = currentStage;
        
        if (age >= 46 && currentStage !== "elder") {
            newStage = "elder";
        } else if (age >= 26 && currentStage !== "parent" && currentStage !== "elder") {
            newStage = "parent";
        } else if (age >= 18 && currentStage !== "youngadult" && currentStage !== "parent" && currentStage !== "elder") {
            newStage = "youngadult";
        } else if (age >= 13 && currentStage !== "teenage" && currentStage !== "youngadult" && currentStage !== "parent" && currentStage !== "elder") {
            newStage = "teenage";
        }
        
        // If stage changed, record the transition
        if (newStage !== currentStage) {
            State.variables.character.lifeStage = newStage;
            
            if (!State.variables.gameProgress.lifeTransitions) {
                State.variables.gameProgress.lifeTransitions = [];
            }
            
            State.variables.gameProgress.lifeTransitions.push({
                from: currentStage,
                to: newStage,
                age: age,
                passage: State.passage
            });
            
            // Update the body class to reflect the new life stage
            this.updateLifePhaseClass();
            
            return true;
        }
        
        return false;
    },
    
    // Environment System Functions
    changeSeason: function() {
        const seasons = ["spring", "summer", "fall", "winter"];
        const currentIndex = seasons.indexOf(State.variables.environment.season);
        const nextIndex = (currentIndex + 1) % 4;
        State.variables.environment.season = seasons[nextIndex];
        
        // Season effects on environment and resources
        switch(State.variables.environment.season) {
            case "spring":
                // Spring effects
                break;
            case "summer":
                // Summer effects
                break;
            case "fall":
                // Fall effects
                break;
            case "winter":
                // Winter effects
                break;
        }
        
        return State.variables.environment.season;
    },
    
    changeWeather: function() {
        const weatherTypes = ["clear", "cloudy", "rainy", "stormy"];
        const currentSeason = State.variables.environment.season;
        let weatherProbabilities;
        
        // Different weather probabilities based on season
        switch(currentSeason) {
            case "spring":
                weatherProbabilities = [0.3, 0.3, 0.3, 0.1]; // More varied
                break;
            case "summer":
                weatherProbabilities = [0.6, 0.2, 0.1, 0.1]; // Mostly clear
                break;
            case "fall":
                weatherProbabilities = [0.3, 0.4, 0.2, 0.1]; // More cloudy
                break;
            case "winter":
                weatherProbabilities = [0.4, 0.3, 0.1, 0.2]; // Clear or stormy
                break;
            default:
                weatherProbabilities = [0.25, 0.25, 0.25, 0.25]; // Equal chance
        }
        
        // Select weather based on probabilities
        let random = Math.random();
        let cumulativeProbability = 0;
        
        for (let i = 0; i < weatherTypes.length; i++) {
            cumulativeProbability += weatherProbabilities[i];
            if (random <= cumulativeProbability) {
                State.variables.environment.weather = weatherTypes[i];
                break;
            }
        }
        
        return State.variables.environment.weather;
    },
    
    // Utility Functions
    randomNumber: function(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    },
    
    addTrait: function(trait) {
        if (!State.variables.character.traits.includes(trait)) {
            State.variables.character.traits.push(trait);
        }
    },
    
    addExperience: function(experience) {
        if (!State.variables.character.experiences) {
            State.variables.character.experiences = [];
        }
        
        State.variables.character.experiences.push({
            event: experience,
            age: State.variables.character.age
        });
    }
};