:: StoryAuthor
Created with Twine Template (TwT)

:: StoryBanner
<h1>Warmth of Tribe</h1>

:: StoryCaption
<<if def $character>>
<div class="character-info">
    <div class="character-basics">
        <span class="character-name"><<print $character.name || "Unnamed">>
        </span>
        <span class="character-age">Age: <<print Math.floor($character.age)>>
        </span>
        <span class="character-stage"><<print $character.lifeStage.toUpperCase()>>
        </span>
    </div>
    
    <<if def $needs>>
    <div class="needs-display">
        <div class="need-bar hunger">
            <span class="need-label">Hunger</span>
            <div class="need-value" style="width: <<print $needs.hunger>>%;"></div>
        </div>
        <div class="need-bar thirst">
            <span class="need-label">Thirst</span>
            <div class="need-value" style="width: <<print $needs.thirst>>%;"></div>
        </div>
        <div class="need-bar fatigue">
            <span class="need-label">Energy</span>
            <div class="need-value" style="width: <<print 100 - $needs.fatigue>>%;"></div>
        </div>
        <div class="need-bar health">
            <span class="need-label">Health</span>
            <div class="need-value" style="width: <<print $needs.health>>%;"></div>
        </div>
    </div>
    <</if>>
    
    <<if def $environment>>
    <div class="environment-info">
        <div class="season-indicator season-<<print $environment.season>>">
            <<print $environment.season.charAt(0).toUpperCase() + $environment.season.slice(1)>> • 
            <<print $environment.weather.charAt(0).toUpperCase() + $environment.weather.slice(1)>>
        </div>
    </div>
    <</if>>
</div>
<</if>>

:: StoryDisplayTitle
Warmth of Tribe

