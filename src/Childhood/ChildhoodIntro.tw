    hunger: 70,
    thirst: 70,
    fatigue: 30,
    health: 100
  }>>
<</if>>

<<if not def $attributes>>
  <<set $attributes = {
    strength: 3,
    dexterity: 3,
    perception: 3,
    intelligence: 3,
    charisma: 3
  }>>
<</if>>

<<if not def $skills>>
  <<set $skills = {
    hunting: 0,
