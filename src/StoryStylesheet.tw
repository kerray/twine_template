:: StoryStylesheet [stylesheet]
/* Base styles with earthy, natural tones for Paleolithic setting */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap');

:root {
    /* Base colors */
    --primary-color: #8B6D5C; /* Earthy brown */
    --primary-dark: #5D4037; /* Dark brown */
    --primary-light: #A1887F; /* Light brown */
    --accent-color: #BF360C; /* Rust/ochre */
    --text-color: #3E2723; /* Dark brown text */
    --bg-color: #F5F3EF; /* Off-white/parchment */
    --ui-bg: #3E2723; /* Dark brown UI */
    --ui-text: #F5F3EF; /* Off-white text */
    --shadow-sm: 0 2px 8px rgba(62, 39, 35, 0.1);
    --shadow-md: 0 4px 12px rgba(62, 39, 35, 0.15);
    --shadow-lg: 0 8px 24px rgba(62, 39, 35, 0.2);
    --transition-fast: 0.2s ease;
    --transition-med: 0.3s ease;
    
    /* Season colors */
    --spring-color: #7CB342; /* Fresh green */
    --summer-color: #FBC02D; /* Warm yellow */
    --fall-color: #E64A19; /* Orange/red */
    --winter-color: #B3E5FC; /* Pale blue */
    
    /* Life phase colors - Childhood */
    --childhood-primary: #8D6E63; /* Softer brown */
    --childhood-accent: #FF9800; /* Warm orange */
    --childhood-bg: #EBE5DC; /* Darker cream for better contrast */
    --childhood-text: #3E2723; /* Dark brown text */
    
    /* Life phase colors - Teenage */
    --teenage-primary: #795548; /* Medium brown */
    --teenage-accent: #FF5722; /* Vibrant orange-red */
    --teenage-bg: #E6DED5; /* Darker peach for better contrast */
    --teenage-text: #3E2723; /* Dark brown */
    
    /* Life phase colors - Young Adult */
    --youngadult-primary: #6D4C41; /* Rich brown */
    --youngadult-accent: #F44336; /* Strong red */
    --youngadult-bg: #E8E2D9; /* Off-white with better contrast */
    --youngadult-text: #3E2723; /* Dark brown */
    
    /* Life phase colors - Parent */
    --parent-primary: #5D4037; /* Deep brown */
    --parent-accent: #8BC34A; /* Nurturing green */
    --parent-bg: #E0DAD1; /* Soft green-white with better contrast */
    --parent-text: #33691E; /* Forest green */
    
    /* Life phase colors - Elder */
    --elder-primary: #4E342E; /* Deep, rich brown */
    --elder-accent: #673AB7; /* Wise purple */
    --elder-bg: #DCD6CD; /* Soft lavender with better contrast */
    --elder-text: #311B92; /* Deep purple */
}

/* Life phase specific styling */
body {
    font-family: 'Crimson Text', serif;
    background-color: var(--bg-color);
    background-image: url('data:image/png;base64,');
    margin: 0;
    padding: 0;
    color: var(--text-color);
    transition: background-color var(--transition-med);
}

/* Apply life phase specific styles */
body.childhood {
    background-color: var(--childhood-bg);
    color: var(--childhood-text);
}

body.teenage {
    background-color: var(--teenage-bg);
    color: var(--teenage-text);
}

body.youngadult {
    background-color: var(--youngadult-bg);
    color: var(--youngadult-text);
}

body.parent {
    background-color: var(--parent-bg);
    color: var(--parent-text);
}

body.elder {
    background-color: var(--elder-bg);
    color: var(--elder-text);
}

/* UI Bar styling with natural wood-like appearance */
#ui-bar {
    background: var(--ui-bg);
    background: linear-gradient(to bottom, #5D4037, #3E2723);
    border-right: 1px solid #2D1E18;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3);
    transition: all var(--transition-med);
}

#ui-bar-body {
    padding: 1.2em;
}

#ui-bar.stowed {
    background: var(--ui-bg);
    border-right: 1px solid #2D1E18;
}

#ui-bar-toggle {
    color: var(--ui-text);
    background-color: #2D1E18;
    border: 1px solid #1B120F;
    border-radius: 4px;
    transition: all var(--transition-fast);
}

#ui-bar-toggle:hover {
    background-color: var(--primary-color);
    transform: scale(1.05);
    box-shadow: var(--shadow-sm);
}

/* Story title styling */
#story-title {
    color: var(--ui-text);
    font-size: 1.7em;
    font-weight: 600;
    margin-bottom: 1.2em;
    text-align: center;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);
    letter-spacing: 1px;
    font-family: 'Poppins', sans-serif;
}

/* Menu button styling */
#menu-core {
    margin-top: 1.2em;
}

#menu-core .button {
    background-color: #4E342E;
    background-image: linear-gradient(to bottom, #5D4037, #4E342E);
    color: var(--ui-text);
    border: 1px solid #3E2723;
    padding: 0.6em;
    margin-bottom: 0.7em;
    width: 100%;
    text-align: center;
    border-radius: 5px;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-sm);
}

#menu-core .button:hover {
    background-image: linear-gradient(to bottom, var(--primary-color), var(--primary-dark));
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

#menu-core .button:active {
    transform: translateY(1px);
    box-shadow: var(--shadow-sm);
}

/* Main content area */
#story {
    margin-left: 17.5em; /* Adjust based on UI bar width */
    padding: 2.5em;
    transition: margin var(--transition-med);
}

#passages {
    max-width: 800px;
    margin: 0 auto;
}

.passage {
    background-color: #E8E2D9; /* Darker background for better contrast */
    padding: 2.5em;
    border-radius: 10px;
    box-shadow: var(--shadow-md);
    line-height: 1.7;
    transition: all var(--transition-med);
    border: 1px solid #D8D0C5;
}

/* Life phase specific passage styling */
body.childhood .passage {
    background-color: var(--childhood-bg);
    border-color: #E0D5C9;
}

body.teenage .passage {
    background-color: var(--teenage-bg);
    border-color: #D8D0C5;
}

body.youngadult .passage {
    background-color: var(--youngadult-bg);
    border-color: #D8D0C5;
}

body.parent .passage {
    background-color: var(--parent-bg);
    border-color: #D0C8BD;
}

body.elder .passage {
    background-color: var(--elder-bg);
    border-color: #C8C0B5;
}

/* Headers styling */
h1 {
    color: var(--primary-dark);
    margin-bottom: 1em;
    font-weight: 600;
    position: relative;
    padding-bottom: 0.3em;
    font-family: 'Poppins', sans-serif;
}

h1::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 60px;
    height: 3px;
    background: var(--accent-color);
    border-radius: 3px;
}

/* Life phase specific header styling */
body.childhood h1 {
    color: var(--childhood-primary);
}

body.childhood h1::after {
    background: var(--childhood-accent);
}

body.teenage h1 {
    color: var(--teenage-primary);
}

body.teenage h1::after {
    background: var(--teenage-accent);
}

body.youngadult h1 {
    color: var(--youngadult-primary);
}

body.youngadult h1::after {
    background: var(--youngadult-accent);
}

body.parent h1 {
    color: var(--parent-primary);
}

body.parent h1::after {
    background: var(--parent-accent);
}

body.elder h1 {
    color: var(--elder-primary);
}

body.elder h1::after {
    background: var(--elder-accent);
}

/* Links styling */
.link-internal {
    color: var(--primary-color);
    text-decoration: none;
    transition: all var(--transition-fast);
    position: relative;
    padding: 0 2px;
}

.link-internal:hover {
    color: var(--accent-color);
    text-decoration: none;
}

.link-internal::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: var(--accent-color);
    transform: scaleX(0);
    transform-origin: bottom right;
    transition: transform 0.3s ease-out;
}

.link-internal:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
}

/* Life phase specific link styling */
body.childhood .link-internal {
    color: var(--childhood-primary);
}

body.childhood .link-internal:hover {
    color: var(--childhood-accent);
}

body.childhood .link-internal::after {
    background-color: var(--childhood-accent);
}

body.teenage .link-internal {
    color: var(--teenage-primary);
}

body.teenage .link-internal:hover {
    color: var(--teenage-accent);
}

body.teenage .link-internal::after {
    background-color: var(--teenage-accent);
}

body.youngadult .link-internal {
    color: var(--youngadult-primary);
}

body.youngadult .link-internal:hover {
    color: var(--youngadult-accent);
}

body.youngadult .link-internal::after {
    background-color: var(--youngadult-accent);
}

body.parent .link-internal {
    color: var(--parent-primary);
}

body.parent .link-internal:hover {
    color: var(--parent-accent);
}

body.parent .link-internal::after {
    background-color: var(--parent-accent);
}

body.elder .link-internal {
    color: var(--elder-primary);
}

body.elder .link-internal:hover {
    color: var(--elder-accent);
}

body.elder .link-internal::after {
    background-color: var(--elder-accent);
}

/* Footer styles */
.footer-links {
    text-align: center;
    margin-top: 2.5em;
    padding-top: 1.2em;
    border-top: 1px solid #D8D0C5;
    color: #8D6E63;
    font-size: 0.9em;
}

/* Needs display styling */
.needs-display {
    background-color: rgba(224, 213, 201, 0.5);
    border: 1px solid #D8D0C5;
    padding: 1em;
    margin-bottom: 1.2em;
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
}

.need-bar {
    height: 20px;
    background-color: #D8D0C5;
    margin-bottom: 0.5em;
    border-radius: 10px;
    position: relative;
    overflow: hidden;
}

.need-label {
    position: absolute;
    left: 10px;
    top: 0;
    font-size: 0.8em;
    line-height: 20px;
    color: #3E2723;
    z-index: 2;
    text-shadow: 0 0 2px rgba(255, 255, 255, 0.5);
}

.need-value {
    height: 100%;
    background-color: #8D6E63;
    border-radius: 10px;
    transition: width 0.3s ease;
}

.hunger .need-value {
    background-color: #FF8A65; /* Orange for hunger */
}

.thirst .need-value {
    background-color: #4FC3F7; /* Blue for thirst */
}

.fatigue .need-value {
    background-color: #9575CD; /* Purple for fatigue */
}

.health .need-value {
    background-color: #81C784; /* Green for health */
}

/* Character info display */
.character-info {
    background-color: rgba(224, 213, 201, 0.5);
    border: 1px solid #D8D0C5;
    padding: 1em;
    margin-bottom: 1.2em;
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
}

.character-basics {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.8em;
    border-bottom: 1px solid #D8D0C5;
    padding-bottom: 0.5em;
}

.character-name {
    font-weight: 600;
    color: var(--primary-dark);
}

.character-age {
    color: #5D4037;
}

.character-stage {
    font-size: 0.8em;
    background-color: #8D6E63;
    color: white;
    padding: 2px 6px;
    border-radius: 3px;
}

/* Life phase specific character stage styling */
body.childhood .character-stage {
    background-color: var(--childhood-primary);
}

body.teenage .character-stage {
    background-color: var(--teenage-primary);
}

body.youngadult .character-stage {
    background-color: var(--youngadult-primary);
}

body.parent .character-stage {
    background-color: var(--parent-primary);
}

body.elder .character-stage {
    background-color: var(--elder-primary);
}

.character-attributes {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.8em;
}

.attribute {
    text-align: center;
    font-size: 0.9em;
    color: #5D4037;
}

.character-traits {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
}

.trait {
    font-size: 0.8em;
    background-color: #D8D0C5;
    color: #5D4037;
    padding: 2px 6px;
    border-radius: 3px;
}

.no-traits {
    font-style: italic;
    color: #8D6E63;
    font-size: 0.9em;
}

/* Skill check display */
.skill-check {
    background-color: rgba(224, 213, 201, 0.5);
    border: 1px solid #D8D0C5;
    padding: 1em;
    margin: 1em 0;
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
}

.skill-check-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5em;
    border-bottom: 1px solid #D8D0C5;
    padding-bottom: 0.5em;
}

.skill-name {
    font-weight: 600;
    color: var(--primary-dark);
}

.skill-difficulty {
    font-size: 0.9em;
    color: #5D4037;
}

.skill-check-result {
    text-align: center;
    padding: 0.5em;
    margin: 0.5em 0;
    border-radius: 5px;
}

.skill-check-result.success {
    background-color: rgba(129, 199, 132, 0.2);
    color: #2E7D32;
}

.skill-check-result.failure {
    background-color: rgba(229, 115, 115, 0.2);
    color: #C62828;
}

/* Season indicators */
.season-indicator {
    display: inline-block;
    padding: 0.3em 0.6em;
    border-radius: 3px;
    font-size: 0.9em;
    margin-bottom: 1em;
}

.season-spring {
    background-color: rgba(124, 179, 66, 0.2);
    color: #33691E;
}

.season-summer {
    background-color: rgba(251, 192, 45, 0.2);
    color: #F57F17;
}

.season-fall {
    background-color: rgba(230, 74, 25, 0.2);
    color: #BF360C;
}

.season-winter {
    background-color: rgba(179, 229, 252, 0.2);
    color: #0277BD;
}

/* Mobile responsiveness */
@media screen and (max-width: 768px) {
    #story {
        margin-left: 0;
        padding: 1.2em;
    }
    
    .passage {
        padding: 1.5em;
    }
    
    h1 {
        font-size: 1.8em;
    }
    
    #ui-bar.stowed {
        box-shadow: none;
    }
    
    #ui-bar-toggle {
        box-shadow: var(--shadow-sm);
    }
    
    .character-basics, .character-attributes {
        flex-direction: column;
        gap: 0.5em;
    }
}

/* Dark mode support */
@media (prefers-color-scheme: dark) {
    :root {
        --bg-color: #2D2418;
        --text-color: #F0EBE5;
        --ui-bg: #1B120F;
        --ui-text: #F0EBE5;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.3);
        --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
        --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.5);
        
        /* Override life phase backgrounds for dark mode */
        --childhood-bg: #3E2E21;
        --teenage-bg: #3A2C1F;
        --youngadult-bg: #362A1D;
        --parent-bg: #32281C;
        --elder-bg: #2E261A;
        
        /* Override text colors for dark mode */
        --childhood-text: #F0EBE5;
        --teenage-text: #F0EBE5;
        --youngadult-text: #F0EBE5;
        --parent-text: #F0EBE5;
        --elder-text: #F0EBE5;
    }
    
    body {
        background-image: linear-gradient(135deg, #2D2418 0%, #1B120F 100%);
        color: var(--text-color);
    }
    
    .passage {
        background-color: #3E2E21;
        color: var(--text-color);
        border-color: #4E3B2A;
    }
    
    .needs-display, .character-info, .skill-check {
        background-color: rgba(62, 46, 33, 0.7);
        border-color: #4E3B2A;
    }
    
    .need-bar {
        background-color: #4E3B2A;
    }
    
    .need-label {
        color: #F0EBE5;
        text-shadow: 0 0 2px rgba(0, 0, 0, 0.5);
    }
    
    .character-basics {
        border-color: #4E3B2A;
    }
    
    .character-name {
        color: #A1887F;
    }
    
    .attribute {
        color: #D7CCC8;
    }
    
    .trait {
        background-color: #4E3B2A;
        color: #D7CCC8;
    }
    
    .footer-links {
        border-top-color: #4E3B2A;
        color: #A1887F;
    }
    
    h1 {
        color: #A1887F;
    }
    
    .link-internal {
        color: #A1887F;
    }
    
    .link-internal:hover {
        color: #BCAAA4;
    }
}